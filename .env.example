# Salin ke `.env` dan sesuaikan. `.env` TIDAK di-commit (lihat .gitignore).
# Secret tidak pernah masuk YAML yang di-commit (AGENTS.md §7).

# Endpoint generator default: Ollama lewat API OpenAI-compatible (ADR-003).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama tidak memeriksa API key, tapi klien OpenAI-compatible mewajibkan
# header-nya ada. Nilai placeholder sudah cukup untuk pemakaian lokal.
OLLAMA_API_KEY=ollama

# Dipakai nanti saat provider LLM via API masuk (ROADMAP F11 item 6).
# ANTHROPIC_API_KEY=
